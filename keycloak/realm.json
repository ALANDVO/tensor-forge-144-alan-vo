{
  "realm": "tensorforge",
  "enabled": true,
  "displayName": "Tensor Forge 144",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "tensorforge-backend",
      "name": "Tensor Forge Backend",
      "description": "Backend service for Tensor Forge 144",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_IN_PRODUCTION",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ],
      "protocolMappers": [
        {
          "name": "role mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-role-mapper",
          "config": {
            "multivalued": "true",
            "user.attribute": "roles",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tensorforge-frontend",
      "name": "Tensor Forge Frontend",
      "description": "Frontend SPA for Tensor Forge 144",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "pkceRequired": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to prompts and evaluations"
      },
      {
        "name": "operator",
        "description": "Create and manage prompts, run evaluations"
      },
      {
        "name": "admin",
        "description": "Full administrative access"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@tensorforge.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE_ME_IN_PRODUCTION",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}